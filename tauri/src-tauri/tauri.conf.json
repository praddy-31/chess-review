{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Review",
  "version": "3.0.0",
  "identifier": "io.github.praddy-31.chess-review",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../engine/build/dist/chess-engine/": "engine/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (C) 2026 the Chess Review authors. GPL-3.0-or-later."
  }
}
